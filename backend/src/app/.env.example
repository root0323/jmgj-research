KAKAO_REST_API_KEY=your-kakao-rest-api-key
VWORLD_API_KEY=your-vworld-api-key
VWORLD_API_REFERER=https://jmgj-frontend.onrender.com
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

METEOBLUE_API_KEY=your-meteoblue-api-key
SKY_BRIGHTNESS_RADIUS_KM=30
SKY_BRIGHTNESS_MAX_PIXELS=1000

# Preferred: python -m app.scripts.local_setup (PYTHONPATH=backend/src).
# Official location-scoped data defaults to the ignored .local-data/ directory.
# RESEARCH_ASSET_DIR=/absolute/path/to/local-data

# Optional pre-existing research assets (DEM must be EPSG:4326, height in meters).
BLACK_MARBLE_H5_PATH=
DEM_RASTER_PATH=

# Optional operator-provided URLs for scripts/download_assets.py.
# Original example GitHub releases do not exist; do not use guessed URLs.
BLACK_MARBLE_H5_URL=
DEM_RASTER_URL=

# Optional minimum sizes in bytes. Use these to catch failed HTML/error downloads.
BLACK_MARBLE_H5_MIN_BYTES=1
DEM_RASTER_MIN_BYTES=1

# Set to true only when deployment must fail if either asset cannot be downloaded.
REQUIRE_SKY_ASSETS=false
