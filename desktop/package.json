{
  "name": "jmgj-research-desktop",
  "version": "0.8.1",
  "private": true,
  "description": "AstroSky astronomy research desktop app",
  "author": "root0323",
  "license": "AGPL-3.0",
  "main": "main.cjs",
  "scripts": {
    "prepare:app": "node scripts/prepare.cjs",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "pack": "electron-builder --win --dir --publish never",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.github.root0323.jmgj-research",
    "productName": "AstroSky",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "runtime.cjs",
      "startup.html",
      "updates.cjs",
      "update-storage.cjs",
      "public-services.json",
      "package.json"
    ],
    "afterPack": "scripts/verify-package.cjs",
    "extraResources": [
      {
        "from": "build/web",
        "to": "web"
      },
      {
        "from": "build/web/node_modules",
        "to": "web/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/backend/jmgj-backend",
        "to": "backend"
      },
      {
        "from": "build/data-catalogue",
        "to": "data"
      },
      {
        "from": "licenses",
        "to": "licenses"
      },
      {
        "from": "NOTICE.txt",
        "to": "NOTICE.txt"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "preCompressedFileExtensions": [
        ".h5"
      ],
      "include": "installer.nsh"
    },
    "artifactName": "JMGJ-Research-${version}-Windows-${arch}-Setup.${ext}",
    "publish": {
      "provider": "github",
      "owner": "root0323",
      "repo": "jmgj-research",
      "private": false,
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
