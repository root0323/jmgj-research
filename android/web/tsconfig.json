{
  "compilerOptions": {
    "target": "ES2022", "lib": ["DOM", "DOM.Iterable", "ES2022"], "strict": true, "skipLibCheck": true,
    "module": "ESNext", "moduleResolution": "bundler", "jsx": "react-jsx", "esModuleInterop": true,
    "resolveJsonModule": true, "noEmit": true, "baseUrl": ".",
    "paths": {
      "@/*": ["../../frontend/*"], "react": ["../../frontend/node_modules/@types/react"],
      "react/*": ["../../frontend/node_modules/@types/react/*"], "react-dom/*": ["../../frontend/node_modules/@types/react-dom/*"]
    },
    "typeRoots": ["../../frontend/node_modules/@types"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "../../frontend/types/**/*.d.ts"]
}
